{
  "name": "inori-collection",
  "version": "1.2.0",
  "description": "水瀬いのりのCD・Blu-ray 所持状況管理PWA（個人利用）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:public": "tsc --noEmit -p tsconfig.json && vite build --mode public",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:pages": "node e2e/pages.mjs",
    "test:e2e:public": "node e2e/public.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:images": "node --experimental-strip-types --no-warnings scripts/check-jackets.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#jackets": "./src/data/jackets.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
